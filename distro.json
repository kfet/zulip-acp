{
  "supervisor": "systemd-user",
  "binary": "~/.local/bin/zulip-acp",
  "require": {
    "zulip_acp": ">=0.31.3",
    "fir": ">=1.11.0"
  },
  "agent": {
    "cmd": "fir --mode acp",
    "kind": "fir"
  },
  "fir": {
    "exts": [
      "github.com/kfet/fir-exts"
    ]
  },
  "service": {
    "config_path": "~/.config/zulip-acp/config.json"
  },
  "systemd": {
    "env_path": "%h/.local/bin:/usr/local/bin:/usr/bin:/bin",
    "restart": "on-failure",
    "restart_sec": "2s",
    "timeout_stop_sec": "90s"
  },
  "config": {
    "channels": [
      "*"
    ],
    "dms": true,
    "relay_mcp": true,
    "hide_thinking": false,
    "stream_edits": false
  },
  "credentials": {
    "env_file": "~/.config/zulip-acp/env"
  },
  "quick_models_catalog": [
    {
      "provider": "anthropic",
      "emoji": "brain",
      "model": "anthropic/claude-opus-5-5",
      "label": "Anthropic · Opus 5.5"
    },
    {
      "provider": "openai-codex",
      "emoji": "robot",
      "model": "openai-codex/gpt-5.5",
      "label": "Codex · GPT-5.5"
    },
    {
      "provider": "github-copilot",
      "emoji": "octopus",
      "model": "github-copilot/claude-sonnet-5.5",
      "label": "Copilot · Sonnet 5.5"
    },
    {
      "provider": "poe",
      "emoji": "speech_balloon",
      "model": "poe/claude-sonnet-5.5",
      "label": "Poe · Sonnet 5.5"
    },
    {
      "provider": "openrouter",
      "emoji": "globe_with_meridians",
      "model": "openrouter/anthropic/claude-opus-5.5",
      "label": "OpenRouter · Opus 5.5"
    }
  ]
}
