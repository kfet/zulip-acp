# zulip-acp systemd user unit template.
#
# Install to ~/.config/systemd/user/zulip-acp.service (edit %h paths are auto),
# then:
#   systemctl --user daemon-reload
#   systemctl --user enable --now zulip-acp
#   loginctl enable-linger $USER
#
# GRACEFUL RELOAD
# ---------------
# `systemctl --user reload zulip-acp` sends SIGHUP, which makes the relay:
#   1. stop polling the Zulip event queue WITHOUT deleting it (messages keep
#      accumulating server-side, so nothing posted during the window is lost);
#   2. wait for every in-flight agent turn to finish posting;
#   3. re-exec the on-disk binary IN PLACE (same PID).
#
# Use it for any binary-only or config-only change. The PID never moves, so
# systemd never observes the service stop, and an agent hosted by this relay
# can run the reload from inside its own turn and still finish its reply.
#
# A hard restart is still required for a change to THIS FILE, and for the
# first cutover onto a build that has reload support at all (the older
# binary has no SIGHUP handler and would simply die).

[Unit]
Description=zulip-acp (fir fleet relay)
After=network-online.target
Wants=network-online.target

[Service]
# systemd user units do NOT inherit your login shell PATH. The ACP agent
# (fir) lives in ~/.local/bin, so it MUST be set explicitly or the relay
# starts, authenticates, resolves channels - then dies with
#   agent start: start agent: exec: "fir": executable file not found in $PATH
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/zulip-acp/env
ExecStart=%h/.local/bin/zulip-acp --config %h/.config/zulip-acp/config.json
# Graceful reload: drain in-flight turns, then re-exec in place.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s
# A stop drains in-flight turns first (-drain-deadline, 30s by default).
# Keep this comfortably above that or systemd SIGKILLs mid-drain.
TimeoutStopSec=90s

[Install]
WantedBy=default.target
